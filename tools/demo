#!/bin/sh
# Set up and build the demo module (modules/demo): a made-up two-lecture course with dummy slides, an exercise sheet
# and lecture captions. Runs every step of the pipeline that does not need Claude. Usage: tools/demo
set -e
cd "$(dirname "$0")/.."
echo "== 1/6 dummy sources";            .venv/bin/python modules/demo/dummy/make_sources.py
echo "== 2/6 ingest (split into pages, build the citation index)"; tools/ingest demo
echo "== 3/6 lectures: coverage of Lecture 1 from its captions"; tools/lectures demo coverage 1
echo "== 4/6 evidence and audit";       tools/lectures demo evidence; tools/lectures demo audit; tools/lectures demo
echo "== 5/6 checks";                   tools/checks demo
echo "== 6/6 build the chapter and the book"
tools/build demo l01 | tail -4
tools/lectures demo gate 1 || true
tools/build demo book | tail -3
echo
echo "Chapter: out/demo/l01/guide.pdf     Book: out/demo/book/guide.pdf     GUI: tools/gui"
